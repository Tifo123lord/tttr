; Engine configuration file.
; DEADLAND: AFTER ZERO - Godot 4 port
config_version=5

[application]
config/name="DEADLAND: AFTER ZERO"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.2", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0

[input]
move_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65),Object(InputEventKey,"physical_keycode":4194311)]}
move_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68),Object(InputEventKey,"physical_keycode":4194313)]}
jump={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":32),Object(InputEventKey,"physical_keycode":87)]}
run={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194325)]}
attack={"deadzone":0.2,"events":[Object(InputEventMouseButton,"button_index":1)]}
shoot={"deadzone":0.2,"events":[Object(InputEventMouseButton,"button_index":2)]}

[layer_names]
2d_physics/layer_1="World"
2d_physics/layer_2="Player"
2d_physics/layer_3="Enemies"
